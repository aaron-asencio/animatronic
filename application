from action.face_palm_action import FacePalmAction
from action.pause_action import PauseAction
from model.orchestrationl import Orchestration

def run():
    facePalmAction = FacePalmAction()
    pauseAction = PauseAction(15)


    # Create orchestration
    orchestration = Orchestration()

    # Add body parts to orchestration queue
    orchestration.add(facePalmAction)
    orchestration.add(pauseAction)
    orchestration.add(facePalmAction)

    # Run orchestration
    orchestration.run()

if __name__ == "__main__":
    run()